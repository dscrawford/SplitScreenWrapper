{
  "frame": {"width": 1920, "height": 1080},
  "layout": {"name": "tree", "split": {"split": "h", "ratio": [1, 3], "children": [
    {"split": "v", "children": [{}, {}]},
    {}
  ]}},
  "instances": [
    {
      "id": "fsa",
      "pre_launch": [
        ["python3", "-m", "splitscreen.handlers.dolphin_gba",
         "--config-dir", "/home/me/.config",
         "--gba", "1=sdl:Xbox 360 Controller", "--gba", "2=keyboard"]
      ],
      "command": [
        "dolphin-emu", "-b", "-e", "/path/to/Four Swords Adventures.rvz",
        "-C", "Dolphin.Core.SIDevice0=13",
        "-C", "Dolphin.Core.SIDevice1=13",
        "-C", "Dolphin.GBA.BIOS=/home/me/.config/dolphin-emu/GBA/gba_bios.bin",
        "-C", "Dolphin.Display.Fullscreen=False"
      ],
      "windows": [
        {"id": "gba1", "match": "^GBA1\\b"},
        {"id": "gba2", "match": "^GBA2\\b"},
        {"id": "main", "match": "^Dolphin"}
      ]
    }
  ]
}
